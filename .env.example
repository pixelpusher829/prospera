# Copy to .env and fill in. `npx convex dev` writes the Convex values for you.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT="local:your-deployment-name"

# Frontend → Convex. In production, use your deployment's URLs
# (Convex dashboard → Settings → URL & Deploy Key).
VITE_CONVEX_URL="https://your-deployment.convex.cloud"
VITE_CONVEX_SITE_URL="https://your-deployment.convex.site"

# Server-side secrets are read by Convex, not from this file. Set them on the deployment:
#   npx convex env set GEMINI_API_KEY "<key>"   # optional, enables the AI advisor
#   node scripts/setup-auth.mjs                  # sign-in keys (JWT_PRIVATE_KEY, JWKS, SITE_URL)
